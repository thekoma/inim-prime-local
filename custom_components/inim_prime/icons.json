{
  "entity": {
    "sensor": {
      "supply_voltage": {
        "default": "mdi:flash"
      },
      "open_zone_count": {
        "default": "mdi:door-open"
      },
      "battery_voltage": {
        "default": "mdi:car-battery"
      },
      "battery_temperature": {
        "default": "mdi:thermometer"
      },
      "battery_resistance": {
        "default": "mdi:omega"
      },
      "gsm_signal": {
        "default": "mdi:signal-cellular-outline",
        "range": {
          "0": "mdi:signal-cellular-outline",
          "1": "mdi:signal-cellular-1",
          "34": "mdi:signal-cellular-2",
          "67": "mdi:signal-cellular-3"
        }
      }
    },
    "binary_sensor": {
      "system_fault": {
        "default": "mdi:alert"
      },
      "low_battery": {
        "default": "mdi:battery-alert"
      },
      "fault_mains": {
        "default": "mdi:power-plug-off"
      },
      "no_phone_line": {
        "default": "mdi:phone-off"
      },
      "jam_radio": {
        "default": "mdi:radio-tower"
      },
      "low_battery_wls": {
        "default": "mdi:battery-alert-variant-outline"
      },
      "disappearance_wls": {
        "default": "mdi:access-point-off"
      },
      "fault_gsm": {
        "default": "mdi:signal-off"
      },
      "sensor_dirty": {
        "default": "mdi:eye-off"
      },
      "zone_fault": {
        "default": "mdi:alert-circle"
      },
      "sirens": {
        "default": "mdi:bullhorn"
      },
      "power_supply": {
        "default": "mdi:power-plug-off"
      },
      "radio_keypads": {
        "default": "mdi:dialpad"
      },
      "tamper": {
        "default": "mdi:shield-alert"
      },
      "comm_internet": {
        "default": "mdi:lan-disconnect"
      },
      "shutter": {
        "default": "mdi:window-shutter",
        "state": {
          "on": "mdi:window-shutter-alert"
        }
      },
      "service_mode": {
        "default": "mdi:wrench-outline",
        "state": {
          "on": "mdi:wrench"
        }
      },
      "programming_mode": {
        "default": "mdi:pencil-off-outline",
        "state": {
          "on": "mdi:pencil"
        }
      }
    },
    "switch": {
      "force_arm_on_open": {
        "default": "mdi:shield-alert-outline"
      }
    },
    "button": {
      "clear_calls": {
        "default": "mdi:phone-cancel"
      }
    }
  },
  "services": {
    "arm_forced": {
      "service": "mdi:shield-lock-open"
    }
  }
}
